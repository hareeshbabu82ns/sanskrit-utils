# Copy to .env and adjust; run.sh loads it automatically.
MONGO_DB_HOST=localhost
MONGO_DB_PORT=27017
MONGO_DB_DB=sansutils
MONGO_DB_USER=sansutils
MONGO_DB_PASSWORD=

# Dev server (0.0.0.0 binds to all interfaces: localhost and host/external IP)
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=1

# Sentence analysis (parse query): seconds allowed per sandhi split / per query
PARSE_SPLIT_TIMEOUT=10
PARSE_TOTAL_TIMEOUT=30
# Longest text (in letters) that splits/parse accept
MAX_TEXT_LENGTH=1000
